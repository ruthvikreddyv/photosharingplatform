# SQLite file for local/demo use. Swap for a Postgres URL in production,
# e.g. postgresql://user:password@host:5432/photo_sharing
DATABASE_URL="file:./dev.db"

# Long random string in production (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

PORT=4000

# Storage driver: "local" (default, saves under backend/uploads) or "s3"
STORAGE_DRIVER="local"

# Only required when STORAGE_DRIVER=s3
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Base URL the frontend uses to build shareable gallery links
PUBLIC_APP_URL="http://localhost:5173"

# Comma-separated origins allowed to call the API
CORS_ORIGIN="http://localhost:5173"
